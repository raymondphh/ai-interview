generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cvs        CV[]
  interviews Interview[]
}

model CV {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  filePath    String
  rawText     String?
  analysis    Json?    // AI analysis result: skills, experience, strengths, weaknesses...
  createdAt   DateTime @default(now())

  interviews Interview[]
}

model Interview {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cvId        String
  cv          CV       @relation(fields: [cvId], references: [id])
  status      String   @default("in_progress") // in_progress | completed
  createdAt   DateTime @default(now())
  completedAt DateTime?

  questions Question[]
}

model Question {
  id           String   @id @default(uuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id])
  content      String
  order        Int
  answerText   String?   // transcribed answer (speech-to-text)
  audioPath    String?
  score        Float?
  feedback     String?
  createdAt    DateTime  @default(now())
}

model QuestionBankItem {
  id        String   @id @default(uuid())
  industry  String
  level     String   // Intern | Fresher | Junior | Middle | Senior | Lead
  content   String
  createdAt DateTime @default(now())

  @@index([industry, level])
}