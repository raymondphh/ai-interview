generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cvs               CV[]
  jobDescriptions   JobDescription[]
  interviews        Interview[]
}

model CV {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  filePath    String
  rawText     String?
  analysis    Json?    // AI analysis result: skills, experience, strengths, weaknesses...
  createdAt   DateTime @default(now())

  interviews Interview[]
}

model JobDescription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  sourceType  String   // file | url
  fileName    String?
  filePath    String?
  sourceUrl   String?
  rawText     String?
  analysis    Json?    // AI: company intro, products, JD requirements...
  createdAt   DateTime @default(now())

  interviews Interview[]
}


model Question {
  id           String   @id @default(uuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id])
  content      String
  order        Int
  answerText   String?   // transcribed answer (speech-to-text)
  audioPath    String?
  score        Float?
  feedback     String?
  createdAt    DateTime  @default(now())
}

model QuestionBankItem {
  id        String   @id @default(uuid())
  industry  String
  level     String   // Intern | Fresher | Junior | Middle | Senior | Lead
  content   String
  createdAt DateTime @default(now())

  @@index([industry, level])
}

model Interview {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cvId        String
  cv          CV       @relation(fields: [cvId], references: [id])
  jdId        String?
  jd          JobDescription? @relation(fields: [jdId], references: [id])
  status      String   @default("in_progress") // in_progress | completed
  createdAt   DateTime @default(now())
  completedAt DateTime?

  // Cho phép "phỏng vấn tiếp" sau khi đã hoàn tất 1 lần: mỗi lần tiếp tục tạo 1 Interview mới,
  // trỏ về lần trước đó để biết những câu hỏi nào đã hỏi rồi (tránh lặp lại).
  round               Int         @default(1)
  previousInterviewId String?
  previousInterview   Interview?  @relation("InterviewChain", fields: [previousInterviewId], references: [id])
  nextInterviews      Interview[] @relation("InterviewChain")

  questions Question[]
}